import("udp") as udp
import("io") as io

func main() {
    var socket = udp:Socket:{
        host = "0.0.0.0",
        port = 0,
        timeout = 5000
    }.bind()

    socket.send_to("hello udp", "127.0.0.1", 9000)

    var packet = socket.recv_from(1024)

    io:println(packet.data)

    socket.close()
}