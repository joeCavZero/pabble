import("http") as http
import("io") as io

func main() {
    var client = http:Client:{
        timeout = 5000,
        max_redirects = 10,
        https_only = false
    }

    var req = http:Request:{
        method = "GET",
        url = "https://example.com",
        body = nil,
        headers = {}
    }

    req = http:set_header(req, "User-Agent", "Penguin")

    var res = client.send(req)

    io:println(res.status)
    io:println(res.ok)
    io:println(res.reason)
    io:println(res.body)
}