import("io") as io
import("threads") as threads

func counter(name) {
    for (var i = 1; i <= 5; i += 1) {
        io:println(name, "->", i)
        threads:yield()
    }

    io:println(name, "finished")
}

func main() {
    io:println("== Yield Example ==")

    var t1 = threads:spawn(counter, "Thread A")
    var t2 = threads:spawn(counter, "Thread B")

    while !t1.is_finished() || !t2.is_finished() {
        threads:yield()
    }

    io:println("All threads finished.")
}