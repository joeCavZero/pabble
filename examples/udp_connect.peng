import("udp") as udp
import("io") as io

func main() {
    var socket = udp:Socket:{
        host = "0.0.0.0",
        port = 0,
        timeout = 5000
    }.bind()

    socket.connect("127.0.0.1", 9000)

    socket.send("hello connected udp")

    var response = socket.recv(1024)

    io:println(response)

    socket.close()
}